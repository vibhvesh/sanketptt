[Unit]
Description=Sanket Central Cloud scheduled backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=sanket
Group=sanket
EnvironmentFile=/etc/sanket-central/agent.env
ExecStart=/opt/sanket-central/venv/bin/python /opt/sanket-central/backup_agent.py --config /etc/sanket-central/agent.json export --type scheduled
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sanket-central
