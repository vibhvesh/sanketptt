# Copy to .env on the server. Generate unique long random passwords. Never commit .env.
POSTGRES_MIGRATOR_PASSWORD=replace-with-long-random-migration-password
POSTGRES_APP_PASSWORD=replace-with-different-long-random-runtime-password
PUBLIC_DOMAIN=cloud.example.com
ACME_EMAIL=admin@example.com

# Cloudflare Dashboard > R2 > Manage R2 API Tokens: scope to this bucket only.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_BUCKET=sanket-central
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me

# S3-compatible R2 endpoint is https://<account-id>.r2.cloudflarestorage.com
# Use region "auto"; never put these credentials in Raspberry Pi configuration.
# The runtime role is created by init-db/002-runtime-role.sh on first database initialization.
DATABASE_URL=postgresql://sanket_cloud_app:replace-me@postgres:5432/sanket_cloud

# Configure these for your chosen OIDC identity provider.
JWT_ISSUER=https://identity.example.com/
JWT_AUDIENCE=sanket-central-cloud
JWKS_URL=https://identity.example.com/.well-known/jwks.json

MAX_UPLOAD_BYTES=5368709120
