# Copy to .env on the server. Never commit real credentials.
# Cloudflare Dashboard > R2 > Manage R2 API Tokens: scope to the one bucket.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_BUCKET=sanket-central
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me

# S3-compatible R2 endpoint is https://<account-id>.r2.cloudflarestorage.com
# Use region "auto"; do not put credentials in Raspberry Pi configuration.
DATABASE_URL=postgresql://sanket_cloud_app:replace-me@postgres:5432/sanket_cloud

# Configure these for your chosen OIDC identity provider.
JWT_ISSUER=https://identity.example.com/
JWT_AUDIENCE=sanket-central-cloud
JWKS_URL=https://identity.example.com/.well-known/jwks.json

MAX_UPLOAD_BYTES=5368709120
