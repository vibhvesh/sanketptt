# Shared password for /leads/ and the API. Required. The service refuses
# searches when this is empty so the page cannot be left open by mistake.
LEADS_TOKEN=change-me

# SQLite file. On Render's free plan the disk is ephemeral; see README.
LEADS_DB_PATH=./data/leads.sqlite

# Comma-separated browser origins allowed to call the API.
LEADS_CORS_ORIGINS=https://sanketptt.com,https://www.sanketptt.com,http://127.0.0.1:8765,http://localhost:8765

# Identify this app to OpenStreetMap. Nominatim requires a contact URL.
NOMINATIM_USER_AGENT=SanketLeads/1.0 (+https://sanketptt.com/leads/; internal sales research)
NOMINATIM_MIN_INTERVAL=1.1

# Short timeout so a hung Overpass mirror does not stall the search.
OVERPASS_TIMEOUT=8
